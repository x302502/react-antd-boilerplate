{
	"semi": true,
	"tabWidth": 2,
	"useTabs": true,
	"printWidth": 80,
	"trailingComma": "none",
	"bracketSpacing": true,
	"bracketSameLine": false,
	"arrowParens": "always",
	"endOfLine": "auto",
	"embeddedLanguageFormatting": "auto",
	"quoteProps": "as-needed",
	"htmlWhitespaceSensitivity": "css"
}
